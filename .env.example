# 复制为 .env 后按需修改（.env 不纳入版本控制）
# 模型下载代理（Clash/V2Ray 等本地代理地址），留空则直连
PICAI_HF_PROXY=http://127.0.0.1:17890
# 推理设备偏好：cuda 或 cpu
# PICAI_DEVICE_PREFERENCE=cuda

# AI 修复（openlux）配置（可选覆盖；默认值见 backend/app/core/config.py）
# PICAI_OPENLUX_KEY_FILE=C:\Users\Administrator\AppData\Roaming\xiaoman\Picai\cookie\openlux.txt
# PICAI_OPENLUX_BASE_URL=https://api.openlux.ai
# PICAI_OPENLUX_EDITS_PATH=/v1/images/edits
# PICAI_OPENLUX_MODEL=gpt-image-2
# PICAI_OPENLUX_QUALITY=high
# 优先按原图分辨率请求；服务不支持时（400/422）自动回退到最接近的支持尺寸
# PICAI_OPENLUX_PREFER_ORIGINAL_SIZE=true
